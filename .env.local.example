# ===============================================
#  AI Tools Hub — متغيرات البيئة
#  انسخ هذا الملف إلى .env.local ثم عبّئ القيم
#  cp .env.local.example .env.local
# ===============================================

# (مطلوب) مفتاح Groq المجاني — أنشئه من https://console.groq.com/keys
# بدون هذا المفتاح تعمل الأدوات تلقائياً بالمحرك التجريبي المحلي.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (اختياري) النموذج المستخدم. الافتراضي llama-3.3-70b-versatile
# وإذا لم يكن متاحاً يجرب التطبيق تلقائياً نماذج بديلة مثل llama3-70b-8192
GROQ_MODEL=llama-3.3-70b-versatile

# (اختياري) حد الطلبات لكل IP في الدقيقة (الافتراضي 12)
RATE_LIMIT=12

# (اختياري) مدة نافذة حد الطلبات بالمللي ثانية (الافتراضي 60000)
RATE_LIMIT_WINDOW_MS=60000

# (اختياري) رابط قاعدة بيانات PostgreSQL لتسجيل إحصائيات الاستخدام.
# إذا لم يكن موجوداً تعمل الموقع بدون إحصائيات ولن يتعطل شيء.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
